  },
  "failure_policy": {
    "singular_fit": "valid completed replicate with explicit singular status",
    "optimizer_or_numerical_failure": "retained as failed; never redrawn",
    "interval_with_failures": "unavailable unless caller explicitly enables incomplete summaries",
    "bound": "one-sided exact Clopper-Pearson plus observed rate"
  },
  "interval_scope": {
    "implemented": ["percentile", "basic"],
    "quantile_convention": "NumPy linear",
