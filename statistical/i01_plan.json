{
  "schema_version": "1.0.0",
  "id": "kamino-i01-bootstrap-assessment-v1",
  "status": "locked-before-assessment",
  "locked_at": "2026-09-15",
  "method": "Gaussian parametric simulation and fixed-effect bootstrap refit",
  "data_generating_model": {
    "formula": "Yield ~ 1 + (1 | Batch)",
